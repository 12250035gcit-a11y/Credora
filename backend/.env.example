# Copy this file to .env and adjust for your environment.
# docker-compose and `mvn spring-boot:run` both read these.

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/credora
SPRING_DATASOURCE_USERNAME=credora
SPRING_DATASOURCE_PASSWORD=credora

# "update" auto-creates/updates tables from the JPA entities - fine for this
# project. Use "validate" in a stricter production setup once the schema is stable.
JPA_DDL_AUTO=update

# Comma-separated list of frontend URLs allowed to call this API.
CREDORA_ALLOWED_ORIGINS=http://localhost:5173

PORT=8080
